#!/bin/sh
# yandex-logger — lightweight status heartbeat + UI history (no rclone spawn).
#
# Why this process exists: on DSM 7 start-stop-status reports the package as
# "running" only while one of its processes is alive. There is NO resident sync
# daemon (sync is a DSM Task Scheduler job), so this near-idle heartbeat is what
# keeps the package shown as started.
#
# It also maintains the status history shown in the UI "Лог" tab — by reading
# var/sync.state directly (written by `yandex-disk sync`), NOT by spawning
# `yandex-disk status` / rclone. The old logger polled `yandex-disk status` every
# 60 s (which spawned the 72 MB rclone binary ~1440x/day just for a version string);
# this one reads a tiny state file every few minutes instead.
#
# shellcheck shell=sh
set -u

: "${YD_PKG_DIR:=/var/packages/YandexDisk}"
. "$YD_PKG_DIR/target/common.sh"

# Single instance only (start-stop-status greps for this script).
ps -eo pid,cmd 2>/dev/null | grep '[y]andex-logger' | grep -v "$$" >/dev/null && exit 1

LOG_INTERVAL="${YD_LOG_INTERVAL:-300}"   # 5 min — matches the typical scheduler cadence
mkdir -p "$LOG_DIR" 2>/dev/null
[ -f "$HISTORY_LOG" ] || : > "$HISTORY_LOG"

LAST=""
while true; do
    CURRENT="$(sync_state_line)"
    if [ "$CURRENT" != "$LAST" ]; then
        rotate_log "$HISTORY_LOG"
        { [ -s "$HISTORY_LOG" ] && echo ""; printf '[%s]\n%s\n' "$(_now)" "$CURRENT"; } >> "$HISTORY_LOG"
        LAST="$CURRENT"
    fi
    sleep "$LOG_INTERVAL"
done
