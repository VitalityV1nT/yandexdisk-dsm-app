#!/bin/sh

# No resident sync daemon in this build: on DSM 7 a backgrounded shell loop is
# unreliable under systemd. Periodic sync is configured as a DSM Task Scheduler job
# that runs 'yandex-disk sync'. Here we only run the lightweight logger/cleaner so
# DSM shows the package as running and the UI keeps a status history.

LOGGER="/var/packages/YandexDisk/scripts/yandex-logger"
CLEANER="/var/packages/YandexDisk/scripts/yandex-cleaner"

case "$1" in
    start)
        # Drop any stale cached rclone version (e.g. after a package upgrade); the
        # first `yandex-disk status` repopulates it, then the per-minute UI poll reads
        # the cache instead of spawning the 72 MB rclone binary on every call.
        rm -f /var/packages/YandexDisk/var/rclone.version 2>/dev/null
        "$LOGGER" &
        "$CLEANER" &
        exit 0
        ;;
    stop)
        pkill -f yandex-logger
        pkill -f yandex-cleaner
        exit 0
        ;;
    status)
        ps -eo cmd | grep -q "[y]andex-logger" && exit 0 || exit 3
        ;;
esac
